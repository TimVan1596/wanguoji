    "GenealogyCardFrame": "One compact card width, geometry and text theme container."
  },
  "royalAdapterPreserved": [
    "original dynasty/kin sources",
    "royal branch window and controls",
    "royal military direct links",
    "political disabilities and restored eligibility",
    "real formal posthumous and temple names"
  ],
  "familyAdapter": [
    "same main trunk and real parent bridges",
    "complete saved genealogy still available",
    "no per-card collapse buttons in main or full mode",
    "full-mode branch controls in selected-person details",
    "one-line overview; other facts in family evidence",
    "civilian members never create military or royal identities"
  ],
  "historicalReading": [
    "event-month faction and previous title rank added at read time, canonical text unchanged",
    "same-month usurpation uses frozen oldStateName/previousRulerTitle for the preceding sovereign",
    "title priority: actual monarch, sourced temple or epithet after recorded death, effective honor; disability overrides current-honor heading",
    "source-ID links to actual factions, old/new family holders, ordinary family members, military/royal archives and live/archived cities",
    "lazy navigation runtime import preserves standalone history rendering and original source-evidence control order"
  ],
  "notReleased": [
    "extra court-service rewards",
    "new offices/peerage/persons",
    "multi-period hereditary revival",
    "new political/population/war probabilities"
  ],
  "nextCourtServiceOption": "Future independent design: a source-bound, once-only political-service credential with limited effect inside an existing qualified appointment opportunity; no automatic rank, separate draw or invented military merit. Not implemented in z47.",
