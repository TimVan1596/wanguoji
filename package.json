{
  "name": "wanguoji",
  "description": "An autonomous alternate-history sandbox where nations, dynasties and empires rise, fall and write their own history.",
  "packageManager": "pnpm@8.5.1",
  "private": true,
  "version": "0.99.17",
  "scripts": {
    "dev": "vite",
    "desktop:compile": "tsc -p desktop/tsconfig.json",
    "desktop:dev": "pnpm desktop:compile && concurrently -k -s first \"vite --host 0.0.0.0 --port 5173 --strictPort\" \"wait-on http://localhost:5173 && GRIDGOD_DESKTOP_DEV_SERVER_URL=http://localhost:5173 electron desktop/dist/main.js\"",
    "desktop:build": "pnpm build && pnpm desktop:compile",
    "desktop:start": "pnpm desktop:build && electron desktop/dist/main.js",
    "test": "vitest run",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "ci": "yarn global add pnpm && pnpm install && pnpm build",
    "start": "vite preview --host 0.0.0.0",
    "docker:build": "docker build -t wanguoji ."
  },
  "devDependencies": {
    "@originjs/vite-plugin-commonjs": "^1.0.3",
    "@types/express": "^4.17.15",
    "@types/js-md5": "^0.7.0",
    "@types/lodash.throttle": "^4.1.7",
    "@types/node-fetch": "^2.6.2",
    "@types/random-useragent": "^0.3.1",
    "@types/react": "^18.0.26",
    "@types/react-color": "^3.0.6",
    "@types/react-dom": "^18.0.10",
    "@types/redux-persist": "^4.3.1",
    "@types/ws": "^8.5.4",
    "@vitejs/plugin-react": "^3.0.0",
    "concurrently": "^10.0.5",
    "electron": "^44.4.3",
    "fast-text-encoding": "^1.0.6",
    "react-router": "^6.6.1",
    "react-router-dom": "^6.6.1",
    "typescript": "^4.9.4",
    "vite": "^4.0.3",
    "vite-plugin-mix": "^0.4.0",
    "vite-plugin-pages": "^0.28.0",
    "vitest": "^0.34.6",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "@emotion/react": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "@mui/material": "^5.11.2",
    "@reduxjs/toolkit": "^1.9.1",
    "@types/crypto-js": "^4.1.1",
    "axios": "^1.2.2",
    "bilibili-live-ws": "^6.2.1",
    "buffer": "^6.0.3",
    "crypto-js": "^4.1.1",
    "events": "^3.3.0",
    "express": "^4.18.2",
    "js-md5": "^0.7.3",
    "lodash.throttle": "^4.1.1",
    "node-fetch": "3.3.0",
    "pako": "^2.1.0",
    "phaser": "^3.55.2",
    "phaser3-rex-plugins": "^1.1.79",
    "random-useragent": "^0.5.0",
    "react": "^18.2.0",
    "react-color": "^2.19.3",
    "react-dom": "^18.2.0",
    "react-redux": "^8.0.5",
    "redux-persist": "^6.0.0",
    "swiper": "^8.4.5"
  }
}
